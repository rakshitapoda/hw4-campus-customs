# Copy to .env and fill in. Never commit the real .env.
# Signs login session tokens. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace-with-a-long-random-string

# Chatbot model access (routed through Portkey). Falls back to OPENAI_API_KEY if PORTKEY_API_KEY is unset.
PORTKEY_API_KEY=your-portkey-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1
OPENAI_MODEL=gpt-4o-mini
